DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-50-plus-characters
DJANGO_ALLOWED_HOSTS=158.23.59.41
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable only if every subdomain uses HTTPS; preload requires a domain.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DB_ENGINE=mysql
DB_NAME=control_flota
DB_USER=control_flota_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Add the exact HTTPS origin of the frontend if it is hosted separately.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://158.23.59.41

MEDIA_ROOT=/var/lib/control-flota/media
STATIC_ROOT=/var/lib/control-flota/staticfiles
