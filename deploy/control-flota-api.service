[Unit]
Description=Control Flota API
After=network.target mysql.service

[Service]
Type=simple
User=control-flota
Group=control-flota
WorkingDirectory=/srv/control-flota-api
EnvironmentFile=/etc/control-flota/api.env
ExecStart=/srv/control-flota-api/.venv/bin/gunicorn flota_api.wsgi:application --bind 127.0.0.1:8000 --workers 3 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
